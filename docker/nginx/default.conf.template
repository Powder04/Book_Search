server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Static assets
    location /css/        { access_log off; }
    location /images/     { access_log off; }
    location /javascript/ { access_log off; }

    # SPA entrypoint
    location = / {
        try_files /index.html =404;
    }

    # REST API — SourceController.getSources() (GET /sources, danh sach nguon cho UI)
    location /sources {
        proxy_pass http://${GATEWAY_HOST}:${GATEWAY_PORT}/sources;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # REST API — SearchController.searchBook() (POST /search)
    location /search {
        proxy_pass http://${GATEWAY_HOST}:${GATEWAY_PORT}/search;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://${WORKER_HOST}:${WORKER_PORT}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # SockJS long-polling / WS cần timeout dài hơn mặc định
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
